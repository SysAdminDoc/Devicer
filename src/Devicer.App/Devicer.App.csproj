<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <RootNamespace>Devicer.App</RootNamespace>
    <Product>Devicer</Product>
    <Company>SysAdminDoc</Company>
    <Copyright>Copyright (c) 2026 Matt Parker</Copyright>
    <AssemblyTitle>Devicer</AssemblyTitle>
    <Description>Unified Windows toolkit for managing rooted Android phones.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Multi-resolution .ico (16/24/32/48/64/96/128/256) so Explorer's tile/list/large
         views all pick a sharp render. Stamps the icon onto Devicer.App.exe so the
         taskbar, Alt-Tab, jump list, and Open With dialog all show the brand mark
         without depending on the WPF Window.Icon binding. -->
    <ApplicationIcon>..\..\branding\logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Devicer.Core\Devicer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\branding\logo.png" Link="Resources\Images\logo.png" />
    <!-- Embedded as a WPF resource so MainWindow / FirstRunWindow can set Icon via the
         standard pack:// URI (sharper than the rasterized PNG at small render sizes). -->
    <Resource Include="..\..\branding\logo.ico" Link="Resources\Images\logo.ico" />
  </ItemGroup>
</Project>
