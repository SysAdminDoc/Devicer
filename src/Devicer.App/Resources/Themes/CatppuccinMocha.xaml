<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Mocha palette tokens. -->
    <Color x:Key="BaseColor">#FF1E1E2E</Color>
    <Color x:Key="MantleColor">#FF181825</Color>
    <Color x:Key="CrustColor">#FF11111B</Color>
    <Color x:Key="Surface0Color">#FF313244</Color>
    <Color x:Key="Surface1Color">#FF45475A</Color>
    <Color x:Key="Surface2Color">#FF585B70</Color>
    <Color x:Key="Overlay0Color">#FF6C7086</Color>
    <Color x:Key="Overlay1Color">#FF7F849C</Color>
    <Color x:Key="SubtextColor">#FFA6ADC8</Color>
    <Color x:Key="TextColor">#FFCDD6F4</Color>
    <Color x:Key="LavenderColor">#FFB4BEFE</Color>
    <Color x:Key="BlueColor">#FF89B4FA</Color>
    <Color x:Key="SapphireColor">#FF74C7EC</Color>
    <Color x:Key="SkyColor">#FF89DCEB</Color>
    <Color x:Key="TealColor">#FF94E2D5</Color>
    <Color x:Key="GreenColor">#FFA6E3A1</Color>
    <Color x:Key="YellowColor">#FFF9E2AF</Color>
    <Color x:Key="PeachColor">#FFFAB387</Color>
    <Color x:Key="MaroonColor">#FFEBA0AC</Color>
    <Color x:Key="RedColor">#FFF38BA8</Color>
    <Color x:Key="MauveColor">#FFCBA6F7</Color>
    <Color x:Key="PinkColor">#FFF5C2E7</Color>

    <Color x:Key="AppBackgroundColor">#FF1E1E2E</Color>
    <Color x:Key="AppSurfaceColor">#FF181825</Color>
    <Color x:Key="AppSurfaceRaisedColor">#FF313244</Color>
    <Color x:Key="AppSurfaceHoverColor">#FF45475A</Color>
    <Color x:Key="AppCanvasColor">#FF11111B</Color>
    <Color x:Key="AppBorderColor">#FF313244</Color>
    <Color x:Key="AppBorderStrongColor">#FF585B70</Color>
    <Color x:Key="AppForegroundColor">#FFCDD6F4</Color>
    <Color x:Key="AppMutedForegroundColor">#FFA6ADC8</Color>
    <Color x:Key="AppSubtleForegroundColor">#FF7F849C</Color>
    <Color x:Key="AppDisabledForegroundColor">#FF6C7086</Color>
    <Color x:Key="AppAccentColor">#FFCBA6F7</Color>
    <Color x:Key="AppAccentHoverColor">#FFDDB6FF</Color>
    <Color x:Key="AppAccentPressedColor">#FFB989EF</Color>
    <Color x:Key="AppAccentForegroundColor">#FF11111B</Color>
    <Color x:Key="AppFocusColor">#FF89B4FA</Color>
    <Color x:Key="AppDestructiveColor">#FFF38BA8</Color>
    <Color x:Key="AppDestructiveForegroundColor">#FF11111B</Color>
    <Color x:Key="AppSuccessColor">#FFA6E3A1</Color>
    <Color x:Key="AppWarningColor">#FFF9E2AF</Color>
    <Color x:Key="AppInfoColor">#FF89B4FA</Color>

    <SolidColorBrush x:Key="Base" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="Mantle" Color="{StaticResource MantleColor}" />
    <SolidColorBrush x:Key="Crust" Color="{StaticResource CrustColor}" />
    <SolidColorBrush x:Key="Surface0" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Overlay0" Color="{StaticResource Overlay0Color}" />
    <SolidColorBrush x:Key="Overlay1" Color="{StaticResource Overlay1Color}" />
    <SolidColorBrush x:Key="Subtext" Color="{StaticResource SubtextColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Lavender" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="Sapphire" Color="{StaticResource SapphireColor}" />
    <SolidColorBrush x:Key="Sky" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Peach" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="Maroon" Color="{StaticResource MaroonColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Mauve" Color="{StaticResource MauveColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurface" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceRaised" Color="{StaticResource AppSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="AppSurfaceHover" Color="{StaticResource AppSurfaceHoverColor}" />
    <SolidColorBrush x:Key="AppCanvas" Color="{StaticResource AppCanvasColor}" />
    <SolidColorBrush x:Key="AppBorder" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="{StaticResource AppBorderStrongColor}" />
    <SolidColorBrush x:Key="AppForeground" Color="{StaticResource AppForegroundColor}" />
    <SolidColorBrush x:Key="AppMutedForeground" Color="{StaticResource AppMutedForegroundColor}" />
    <SolidColorBrush x:Key="AppSubtleForeground" Color="{StaticResource AppSubtleForegroundColor}" />
    <SolidColorBrush x:Key="AppDisabledForeground" Color="{StaticResource AppDisabledForegroundColor}" />
    <SolidColorBrush x:Key="AppAccent" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHover" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentPressed" Color="{StaticResource AppAccentPressedColor}" />
    <SolidColorBrush x:Key="AppAccentForeground" Color="{StaticResource AppAccentForegroundColor}" />
    <SolidColorBrush x:Key="AppFocus" Color="{StaticResource AppFocusColor}" />
    <SolidColorBrush x:Key="AppDestructive" Color="{StaticResource AppDestructiveColor}" />
    <SolidColorBrush x:Key="AppDestructiveForeground" Color="{StaticResource AppDestructiveForegroundColor}" />
    <SolidColorBrush x:Key="AppSuccess" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppWarning" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppInfo" Color="{StaticResource AppInfoColor}" />
</ResourceDictionary>
