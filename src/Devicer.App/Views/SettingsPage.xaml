<UserControl x:Class="Devicer.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels"
             xmlns:svc="clr-namespace:Devicer.App.Services">
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock Text="Theme, behavior, tool detection, and where Devicer keeps its data."
                       Style="{StaticResource SubheadingTextBlock}" />

            <!-- Settings save error banner -->
            <Border Style="{StaticResource Card}"
                    Background="#22F38BA8"
                    BorderBrush="{DynamicResource AppDestructive}"
                    Margin="0,0,0,12"
                    Visibility="{Binding SettingsSaveError, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="SETTINGS NOT PERSISTING" FontWeight="Bold" Foreground="{DynamicResource AppDestructive}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SettingsSaveError}" TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" />
                </StackPanel>
            </Border>

            <!-- ADB version warning banner -->
            <Border Style="{StaticResource Card}"
                    Background="#22F9E2AF"
                    BorderBrush="{DynamicResource AppWarning}"
                    Margin="0,0,0,12"
                    Visibility="{Binding AdbVersionWarning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="ADB version is below 36.0.2. Older versions have a Samsung device-detection bug and a Windows file-truncation bug during push/pull that can corrupt transferred boot images. Update to Platform-Tools 37+." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              Width="200" HorizontalAlignment="Left"
                              AutomationProperties.Name="Theme selector" />
                    <TextBlock Text="Catppuccin Mocha (dark) and Catppuccin Latte (light). Switches live."
                               Style="{StaticResource MutedTextBlock}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Behavior" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Hot-plug probe interval (seconds)" Style="{StaticResource FieldLabel}" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding ProbeIntervalSeconds, StringFormat={}{0}s}"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource AppAccent}"
                                   FontWeight="SemiBold"
                                   Width="40" TextAlignment="Right" />
                        <Slider Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding ProbeIntervalSeconds, Mode=TwoWay}"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                AutomationProperties.Name="Probe interval seconds" />
                    </DockPanel>
                    <TextBlock Text="Devicer re-probes adb / fastboot at this interval to catch USB plug / unplug events. Lower is more responsive but slightly more CPU; 4s is the default."
                               Style="{StaticResource MutedTextBlock}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Tools -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Content="Re-check"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshToolStatusCommand}"
                                AutomationProperties.Name="Re-check platform tools availability" />
                        <TextBlock Text="Platform-Tools" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                    <TextBlock Text="adb" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding AdbStatus}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="fastboot" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding FastbootStatus}" Style="{StaticResource MonoValue}" />
                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="12">
                        Install Android SDK Platform-Tools v37+ from
                        <Hyperlink NavigateUri="https://developer.android.com/tools/releases/platform-tools"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource AppAccent}">developer.android.com/tools/releases/platform-tools</Hyperlink>
                        and ensure adb / fastboot are on your PATH.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Content="Open data folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenSettingsFolderCommand}"
                                AutomationProperties.Name="Open Devicer data folder" />
                        <TextBlock Text="About" Style="{StaticResource SectionLabel}" />
                    </DockPanel>
                    <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                    <TextBlock Style="{StaticResource MonoValue}">
                        <Run Text="Devicer " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Settings file" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="Crash log" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding CrashlogPath}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="Tool cache" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ToolsCachePath}" Style="{StaticResource MonoValue}" />
                    <Button Content="Re-run setup wizard"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RerunSetupWizardCommand}"
                            Margin="0,4,0,4" HorizontalAlignment="Left"
                            AutomationProperties.Name="Re-run first-run setup wizard" />
                    <TextBlock Text="{Binding OpenFolderError}"
                               Foreground="{DynamicResource AppWarning}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="{Binding OpenFolderError, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
