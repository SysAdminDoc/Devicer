<UserControl x:Class="Devicer.App.Views.FirmwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
        </Style>
        <Style x:Key="RegionResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppSurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AppSurfaceRaised}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AppAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Check latest"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckLatestCommand}"
                            IsEnabled="{Binding IsIdle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Check latest firmware from Samsung OTA" />
                    <Button Content="Download &amp; decrypt"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding DownloadLatestCommand}"
                            AutomationProperties.Name="Download and decrypt firmware" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Firmware" Style="{StaticResource HeadingTextBlock}" />
                    <TextBlock Text="Latest official firmware available from Samsung's public OTA feed for the model + CSC region(s) below."
                               Style="{StaticResource SubheadingTextBlock}" />
                </StackPanel>
            </DockPanel>

            <!-- Diagnostic banner -->
            <Border Style="{StaticResource Card}"
                    Background="#22F9E2AF"
                    BorderBrush="{DynamicResource AppWarning}"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- Geofence failover: deep-link to public mirrors that don't region-lock. -->
                    <StackPanel Margin="30,12,0,0"
                                Visibility="{Binding HasGeofenceFailover, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="OPEN IN BROWSER (PUBLIC MIRRORS)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Mirrors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,8"
                                            Command="{Binding DataContext.OpenMirrorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Note}">
                                        <TextBlock Text="{Binding Name}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" TextWrapping="Wrap"
                                   Text="These mirrors re-host Samsung firmware on their own CDNs and don't region-geofence. Cross-check the SHA256 across at least two mirrors before flashing." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Form -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                     AutomationProperties.Name="Device model number" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="CSC / REGIONS" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Csc, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separate multiple CSCs with commas or spaces"
                                     Margin="0,0,0,12"
                                     AutomationProperties.Name="CSC region codes" />
                        </StackPanel>
                    </Grid>
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="IMEI (required for download)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Open IMEI on phone"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ShowImeiOnPhoneCommand}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Show IMEI settings page on phone" />
                    </DockPanel>
                    <!-- Editable ComboBox: type a new 15-digit IMEI OR pick a previously-used one. -->
                    <ComboBox IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="Imei"
                              ItemsSource="{Binding ImeiHistory}"
                              Text="{Binding Imei, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding SelectedImeiEntry}"
                              FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                              Margin="0,0,0,4"
                              AutomationProperties.Name="IMEI input and history">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="420" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Imei}"
                                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource AppForeground}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppMutedForeground}">
                                            <Run Text="{Binding Model, Mode=OneWay, FallbackValue=''}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding Csc, Mode=OneWay, FallbackValue=''}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            ToolTip="Forget this IMEI"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="28" MinHeight="22" Padding="0"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveImeiHistoryCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" TextWrapping="Wrap"
                               Text="Samsung's FUS rejects fake IMEIs as of late 2024. Modern One UI 7+ blocks programmatic IMEI reads even via root — click 'Open IMEI on phone' to pop the Settings page on the device, then enter the 15-digit number above. Devicer remembers every IMEI you've used; pick one from the dropdown to skip the typing." />
                </StackPanel>
            </Border>

            <!-- Region results -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16"
                    Visibility="{Binding RegionResults.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="CSC RESULTS" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding RegionResults}"
                             SelectedItem="{Binding SelectedRegionResult}"
                             ItemContainerStyle="{StaticResource RegionResultItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ToolTip="Selected row controls which CSC is used by Download &amp; decrypt"
                             AutomationProperties.Name="CSC region firmware results">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="78,*,150">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Csc}"
                                               FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding LatestPda}"
                                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                                   FontSize="13"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Foreground="{DynamicResource AppMutedForeground}"
                                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap">
                                            <Run Text="CSC " />
                                            <Run Text="{Binding LatestCsc}" />
                                            <Run Text=" / CP " />
                                            <Run Text="{Binding LatestCp}" />
                                            <Run Text=" / BOOT " />
                                            <Run Text="{Binding LatestBoot}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="{DynamicResource AppMutedForeground}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Result -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="LATEST AVAILABLE" Style="{StaticResource FieldLabel}" Margin="0" />
                        <Border DockPanel.Dock="Right"
                                Style="{StaticResource BadgeWarning}"
                                Visibility="{Binding UpdateAvailable, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="Update available" Foreground="{DynamicResource AppWarning}" FontWeight="SemiBold" />
                        </Border>
                        <Border DockPanel.Dock="Right"
                                Style="{StaticResource BadgeSuccess}"
                                Visibility="{Binding ShowUpToDateBadge, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                            <TextBlock>
                                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource AppSuccess}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <TextBlock Text="PDA" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Latest.Pda, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource MonoValue}" />

                    <TextBlock Text="CSC" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Latest.Csc, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource MonoValue}" />

                    <TextBlock Text="MODEM (CP)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Latest.Cp, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource MonoValue}" />

                    <TextBlock Text="BOOT" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Latest.Boot, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource MonoValue}" />

                    <Separator Margin="0,4,0,12" Background="{DynamicResource AppBorder}" />

                    <TextBlock Text="CURRENTLY INSTALLED (PDA)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding CurrentBuildId, FallbackValue='— (no device selected)', TargetNullValue='— (no device selected)'}" Style="{StaticResource MonoValue}" />
                </StackPanel>
            </Border>

            <!-- Download progress -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsDownloading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDownloadCommand}"
                                AutomationProperties.Name="Cancel firmware download" />
                        <TextBlock Text="DOWNLOAD IN PROGRESS" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Height="10"
                                 IsIndeterminate="{Binding HasProgressFraction, Converter={x:Static vm:NotConverter.Instance}}"
                                 Background="{DynamicResource AppSurface}"
                                 Foreground="{DynamicResource AppAccent}"
                                 BorderBrush="{DynamicResource AppBorder}"
                                 Margin="0,0,0,8" />
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ProgressDisplay, Mode=OneWay}"
                                   Foreground="{DynamicResource AppMutedForeground}"
                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                   FontSize="12" />
                        <TextBlock Text="{Binding DownloadStatus}"
                                   Foreground="{DynamicResource AppForeground}"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Last download summary -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16"
                    Visibility="{Binding LastDecryptedPath, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenDownloadFolderCommand}"
                                AutomationProperties.Name="Open downloaded firmware folder" />
                        <TextBlock Text="LAST DOWNLOAD" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="DECRYPTED" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding LastDecryptedPath, FallbackValue='—'}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="ENCRYPTED" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding LastDownloadedPath, FallbackValue='—'}" Style="{StaticResource MonoValue}" />
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding History.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="UPGRADE HISTORY" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Raw}"
                                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                           Foreground="{DynamicResource AppMutedForeground}"
                                           Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Footer note -->
            <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap">
                Devicer talks directly to Samsung's FUS (Smart Switch protocol) — no Samsung account, no third-party servers.
                Encrypted blobs and decrypted firmware are cached at <Run FontFamily="Consolas, JetBrains Mono, Cascadia Mono" Text="%LOCALAPPDATA%\Devicer\firmware\" />.
                AES decryption (ECB + PKCS#7) runs locally; nothing leaves your machine.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
