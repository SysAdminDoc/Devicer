<UserControl x:Class="Devicer.App.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsProbing, Converter={x:Static vm:NotConverter.Instance}}" />
                <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource HeadingTextBlock}" />
                    <TextBlock Text="Probes adb + fastboot, identifies the connected phone, surfaces ROM and root state."
                               Style="{StaticResource SubheadingTextBlock}" />
                </StackPanel>
            </DockPanel>

            <!-- Diagnostic banner -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Background="#33F9E2AF"
                    BorderBrush="{DynamicResource AppWarning}"
                    Margin="0,0,0,16"
                    Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Connected devices -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="CONNECTED" Style="{StaticResource LabelTextBlock}" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource AppSuccess}" />
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text=" — " Foreground="{DynamicResource AppSubtleForeground}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Serial}" FontFamily="Consolas" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                    <TextBlock Text=" · " Foreground="{DynamicResource AppSubtleForeground}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionState}" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No devices detected. Plug in a phone with USB debugging enabled."
                               Style="{StaticResource MutedTextBlock}"
                               Visibility="{Binding Devices.Count, Converter={x:Static vm:CountToCollapsedConverter.Instance}}" />
                </StackPanel>
            </Border>

            <!-- Selected device detail -->
            <Border Grid.Row="3"
                    Style="{StaticResource Card}"
                    Visibility="{Binding SelectedDevice, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <Grid DataContext="{Binding SelectedDevice}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="CODENAME" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Codename, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="ANDROID" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="{Binding AndroidVersion, FallbackValue=—, TargetNullValue=—}" />
                            <Run Text=" (SDK " /><Run Text="{Binding AndroidSdk, FallbackValue=?, TargetNullValue=?}" /><Run Text=")" />
                        </TextBlock>

                        <TextBlock Text="BUILD FINGERPRINT" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding BuildFingerprint, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="SECURITY PATCH" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SecurityPatch, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="ROOT STATUS" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding Root.IsRooted, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                <TextBlock>
                                    <Run Text="{Binding Root.Kind, Mode=OneWay}" />
                                    <Run Text=" " /><Run Text="{Binding Root.Version, FallbackValue='', TargetNullValue=''}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource BadgeInfo}"
                                    Visibility="{Binding Root.IsRooted, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Not rooted" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right column (Samsung-tinted) -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="CSC (SAMSUNG)" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="{Binding Csc, FallbackValue=—, TargetNullValue=—}" />
                            <Run Text=" / " />
                            <Run Text="{Binding CscCountry, FallbackValue=—, TargetNullValue=—}" />
                        </TextBlock>

                        <TextBlock Text="BOOTLOADER" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding BootloaderVersion, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="BASEBAND" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding BasebandVersion, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="SLOT (A/B)" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldValue}">
                            <Run Text="{Binding CurrentSlot, FallbackValue='—', TargetNullValue='—'}" />
                            <Run Text=" · A/B: " /><Run Text="{Binding IsAbDevice, FallbackValue=?, TargetNullValue=?}" />
                        </TextBlock>

                        <TextBlock Text="ENCRYPTION" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding EncryptionState, FallbackValue=—, TargetNullValue=—}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="OEM UNLOCK" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding OemUnlockSupported, FallbackValue=unknown, TargetNullValue=unknown}" Style="{StaticResource FieldValue}" />

                        <TextBlock Text="KNOX WARRANTY BIT" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding KnoxWarrantyBit, Converter={x:Static vm:KnoxIntactToVisibilityConverter.Instance}}">
                                <TextBlock Text="Intact" />
                            </Border>
                            <Border Style="{StaticResource BadgeDanger}"
                                    Visibility="{Binding KnoxWarrantyBit, Converter={x:Static vm:KnoxTrippedToVisibilityConverter.Instance}}">
                                <TextBlock>
                                    <Run Text="Tripped (" /><Run Text="{Binding KnoxWarrantyBit, FallbackValue=?, TargetNullValue=?}" /><Run Text=") — eFuse, irreversible" />
                                </TextBlock>
                            </Border>
                            <TextBlock Text="—" Style="{StaticResource MutedTextBlock}"
                                       Visibility="{Binding KnoxWarrantyBit, Converter={x:Static vm:NullToVisibleConverter.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
