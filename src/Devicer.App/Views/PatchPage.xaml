<UserControl x:Class="Devicer.App.Views.PatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Browse boot.img"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseBootImageCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Patch on-device"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding PatchCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Patch boot image" Style="{StaticResource HeadingTextBlock}" />
                    <TextBlock Text="Pushes the selected boot.img / init_boot.img to the connected device, runs the on-device root manager's patcher (Magisk / KernelSU / APatch), pulls the patched output back. No PC-side Python required."
                               Style="{StaticResource SubheadingTextBlock}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DEVICE" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Model, FallbackValue='— (no device selected)', TargetNullValue='— (no device selected)'}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="ROOT MANAGER" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding RootKindDisplay, FallbackValue='—', TargetNullValue='—'}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="PATCH TARGET" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding PatchTargetHint, FallbackValue='—', TargetNullValue='—'}"
                               Foreground="{DynamicResource AppAccent}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="BOOT IMAGE" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding BootImagePath, FallbackValue='(none — click Browse)', TargetNullValue='(none — click Browse)'}"
                               Style="{StaticResource MonoValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding StatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsPatching, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Background="#22F9E2AF"
                    BorderBrush="{DynamicResource AppWarning}"
                    Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding OutputPath, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenOutputFolderCommand}" />
                        <TextBlock Text="PATCHED OUTPUT" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MonoValue}" />
                    <TextBlock Text="SHA256" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding OutputSha256}" Style="{StaticResource MonoValue}" />
                </StackPanel>
            </Border>

            <!-- PC-side patcher fallback -->
            <Border Height="1" Background="{DynamicResource AppCardBorder}" Margin="0,16,0,16" />
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="PC-side patch"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding PcPatchCommand}" />
                <StackPanel>
                    <TextBlock Text="PC-side patcher" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource AppForeground}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubheadingTextBlock}"
                               Text="Patch boot.img on this PC using affggh/Magisk_patcher. No rooted device required — useful when you have a boot.img but the device has no root manager installed." />
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="0,0,0,12"
                       Visibility="{Binding IsPcPatcherAvailable, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                Magisk_patcher not found on PATH or in the tools cache. Install affggh/Magisk_patcher or set its path in Settings.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
