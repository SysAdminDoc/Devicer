<UserControl x:Class="Devicer.App.Views.RomsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Cascadia Mono" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- Heading -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Search"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Search for custom ROMs" />
            <StackPanel>
                <TextBlock Text="Custom ROMs" Style="{StaticResource HeadingTextBlock}" />
                <TextBlock Text="Aggregated builds from LineageOS and crDroid for the device codename below."
                           Style="{StaticResource SubheadingTextBlock}" />
            </StackPanel>
        </DockPanel>

        <!-- Diagnostic -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Background="#22F9E2AF"
                BorderBrush="{DynamicResource AppWarning}"
                Margin="0,0,0,16"
                Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="DEVICE CODENAME" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Codename, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Device codename input" />
                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Lowercase, e.g. 'cheeseburger', 'alioth', 'pa3q'. Auto-fills from the connected device on the Device tab." />
            </StackPanel>
        </Border>

        <!-- Download progress panel -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Margin="0,0,0,16"
                Visibility="{Binding DownloadStatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenDownloadFolderCommand}"
                                Margin="0,0,6,0"
                                Visibility="{Binding LastDownloadPath, Converter={x:Static vm:NullToCollapsedConverter.Instance}}"
                                AutomationProperties.Name="Open ROM download folder" />
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDownloadCommand}"
                                Visibility="{Binding IsDownloading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                                AutomationProperties.Name="Cancel ROM download" />
                    </StackPanel>
                    <TextBlock Text="{Binding DownloadStatusText}"
                               Foreground="{DynamicResource AppForeground}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Height="4"
                             Minimum="0" Maximum="100"
                             Value="{Binding DownloadProgressFraction, Converter={x:Static vm:FractionToPercentConverter.Instance}}"
                             Foreground="{DynamicResource AppAccent}"
                             Background="{DynamicResource AppCardBackground}"
                             Visibility="{Binding IsDownloading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Border>

        <!-- Status line -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource AppMutedForeground}"
                   FontSize="12"
                   Margin="0,0,0,12"
                   Visibility="{Binding StatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />

        <!-- Results -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SourceDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppAccent}"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding KindDisplay}"
                                               FontSize="11"
                                               Typography.Capitals="AllSmallCaps"
                                               Foreground="{DynamicResource AppSubtleForeground}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Version}"
                                               Foreground="{DynamicResource AppForeground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Open forum"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenForumCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding ForumUrl, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                    <Button Content="Browser"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Download"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.DownloadRomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding FileName}"
                                           Style="{StaticResource MonoValue}"
                                           Margin="0,0,0,4" />

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11" Margin="0,0,16,0">
                                        <Run Text="{Binding BuildDate, StringFormat='Built {0:yyyy-MM-dd}', Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11" Margin="0,0,16,0"
                                               Text="{Binding SizeDisplay}" />
                                    <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11" Margin="0,0,16,0"
                                               Visibility="{Binding Maintainer, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                                        <Run Text="by " /><Run Text="{Binding Maintainer, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11"
                                               Visibility="{Binding Sha256, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                                        <Run Text="SHA256 verified" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
