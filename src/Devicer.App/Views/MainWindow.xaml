<Window x:Class="Devicer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Devicer.App.ViewModels"
        Title="Devicer"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource AppForeground}"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <Style x:Key="AppTitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="20,18,20,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AppAccent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Devicer" Style="{StaticResource AppTitleText}" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="20,8,20,16">
                    <StackPanel>
                        <TextBlock Text="v0.2.0" Style="{StaticResource MutedTextBlock}" FontSize="11" />
                        <TextBlock Text="Local-only build" Style="{StaticResource MutedTextBlock}" FontSize="10" Opacity="0.7" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Style="{StaticResource NavListBox}"
                         BorderThickness="0"
                         Margin="6,8,6,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource NavGlyph}" />
                                <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
