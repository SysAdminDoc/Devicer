<UserControl x:Class="Devicer.App.Views.StubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,32">
        <StackPanel VerticalAlignment="Top">
            <TextBlock x:Name="HeadingText" Text="Section" Style="{StaticResource HeadingTextBlock}" />
            <TextBlock x:Name="SubheadingText" Text="Coming in a later version." Style="{StaticResource SubheadingTextBlock}" />
            <Border Style="{StaticResource Card}" Padding="20" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Not implemented yet." FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="DetailText"
                               Text="See the project ROADMAP for the planned scope of this section."
                               Style="{StaticResource MutedTextBlock}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
