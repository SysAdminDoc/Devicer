<Window x:Class="Devicer.App.Views.FlashWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Devicer.App.ViewModels"
        Title="Flash Wizard — Devicer"
        Width="700" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource AppForeground}"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="32,28,32,16">
            <StackPanel>

                <!-- Step 1: Select Device -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={x:Static vm:WizardStepToVisibilityConverter.SelectDevice}}">
                    <TextBlock Text="Step 1 — Select Device" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,8" />
                    <TextBlock Text="Choose the connected device to flash." Style="{StaticResource SubheadingTextBlock}" Margin="0,0,0,16" />
                    <ListBox ItemsSource="{Binding AvailableDevices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AutomationProperties.Name="Select target device">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding Serial, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Step 2: Select Firmware -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={x:Static vm:WizardStepToVisibilityConverter.SelectFirmware}}">
                    <TextBlock Text="Step 2 — Select Firmware" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,8" />
                    <TextBlock Text="Browse for the firmware archive (.tar.md5, .zip) or individual image (.img) to flash."
                               Style="{StaticResource SubheadingTextBlock}" Margin="0,0,0,16" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource PrimaryButton}"
                                Command="{Binding BrowseFirmwareCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="Browse for firmware file" />
                        <TextBlock Text="{Binding FirmwarePath, FallbackValue='(none — click Browse)', TargetNullValue='(none — click Browse)'}"
                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>

                <!-- Step 3: Review Plan -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={x:Static vm:WizardStepToVisibilityConverter.ReviewPlan}}">
                    <TextBlock Text="Step 3 — Review Plan" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,8" />
                    <TextBlock Text="Verify the flash plan before proceeding." Style="{StaticResource SubheadingTextBlock}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <TextBlock Text="{Binding PlanSummary}"
                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppForeground}" />
                    </Border>
                </StackPanel>

                <!-- Step 4: Confirm -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={x:Static vm:WizardStepToVisibilityConverter.Confirm}}">
                    <TextBlock Text="Step 4 — Confirm" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource Card}" Background="#22F38BA8" BorderBrush="{DynamicResource AppDestructive}" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}">
                            This will write data to the device. This operation cannot be undone without a backup. Verify the plan above is correct.
                        </TextBlock>
                    </Border>
                    <CheckBox IsChecked="{Binding UserConfirmed, Mode=TwoWay}"
                              AutomationProperties.Name="Confirm destructive flash operation">
                        <CheckBox.Content>
                            <TextBlock Text="I understand this writes to the device and cannot be undone" FontWeight="SemiBold" />
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>

                <!-- Step 5: Complete -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={x:Static vm:WizardStepToVisibilityConverter.Complete}}">
                    <TextBlock Text="Complete" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Navigation buttons -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="32,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{Binding NextLabel}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextCommand}" Margin="8,0,0,0"
                        AutomationProperties.Name="Next wizard step"
                        Visibility="{Binding IsComplete, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                <Button DockPanel.Dock="Right" Content="Back" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}"
                        AutomationProperties.Name="Previous wizard step" />
                <Button DockPanel.Dock="Left" Content="Close" Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"
                        Visibility="{Binding IsComplete, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                        AutomationProperties.Name="Close wizard" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
