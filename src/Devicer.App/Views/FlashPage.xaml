<UserControl x:Class="Devicer.App.Views.FlashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Browse"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseArchiveCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Inspect"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding InspectCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Dry-run plan"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding DryRunCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Flash" Style="{StaticResource HeadingTextBlock}" />
                <TextBlock Style="{StaticResource SubheadingTextBlock}"
                           Text="Inspect Samsung Odin tar/.tar.md5 packages and dry-run a flash plan. Actual writes are gated to a future release; v0.7.0 ships the inspector + safety gates so you can validate a firmware before committing." />
            </StackPanel>
        </DockPanel>

        <!-- Knox banner -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Background="#22F38BA8"
                BorderBrush="{DynamicResource AppDestructive}"
                Margin="0,0,0,12"
                Visibility="{Binding IsKnoxIntact, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="KNOX IS INTACT — DON'T LOSE IT BY ACCIDENT" FontWeight="Bold" Foreground="{DynamicResource AppDestructive}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}">
                    Flashing a custom AP / kernel / boot image WILL trip the Knox eFuse permanently and disable Samsung Pay, Secure Folder, Health, and corporate enrollment. Once tripped, only board replacement reverses it. Flash stock-only via Odin to keep Knox alive.
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Background="#22F9E2AF"
                BorderBrush="{DynamicResource AppWarning}"
                Margin="0,0,0,12"
                Visibility="{Binding IsKnoxTripped, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Knox eFuse is already tripped (warranty bit ≠ 0). Custom flashing has been performed before; further flashes won't restore Knox features." />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- EFS-Clear gate -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox IsChecked="{Binding EfsClearEnabled, Mode=TwoWay}">
                    <CheckBox.Content>
                        <TextBlock>
                            <Run Text="EFS-Clear" FontWeight="Bold" /><Run Text=" — wipe /efs (IMEI / NVRAM). DO NOT enable unless you have an EFS backup AND know exactly why." />
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="24,4,0,0" TextWrapping="Wrap">
                    OFF by default (correct). Toggling this is one of the fastest ways to brick a Samsung permanently.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Diagnostic -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Background="#22F9E2AF"
                BorderBrush="{DynamicResource AppWarning}"
                Margin="0,0,0,12"
                Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Archive path -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ARCHIVE" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding ArchivePath, FallbackValue='(none)', TargetNullValue='(none)'}"
                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                           FontSize="12"
                           Foreground="{DynamicResource AppForeground}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" TextWrapping="Wrap"
                           Visibility="{Binding Info, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <Run Text="Package hint:" /><Run Text="{Binding Info.PackageHint, FallbackValue='?', Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <Border Grid.Row="5" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Entry.Name}"
                                               FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                               FontSize="13"
                                               Foreground="{DynamicResource AppForeground}" />
                                    <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11">
                                        <Run Text="→ " /><Run Text="{Binding Entry.PartitionGuess, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Entry.SizeDisplay}"
                                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppMutedForeground}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status / dry-run output -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding StatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding StatusText}"
                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                           FontSize="12"
                           Foreground="{DynamicResource AppForeground}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
