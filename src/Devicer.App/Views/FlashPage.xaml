<UserControl x:Class="Devicer.App.Views.FlashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- Heading -->
            <TextBlock Text="Flash" Style="{StaticResource HeadingTextBlock}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SubheadingTextBlock}" Margin="0,0,0,16"
                       Text="Samsung Odin archive inspection + fastboot flash queue for non-Samsung devices." />

            <!-- Play Integrity warning -->
            <Border Style="{StaticResource Card}"
                    Background="#22F9E2AF"
                    BorderBrush="{DynamicResource AppWarning}"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                        <Run FontWeight="SemiBold" Text="Play Integrity impact: " />
                        <Run Text="Bootloader unlock and custom flashing will fail Play Integrity DEVICE and STRONG verdicts. Samsung Pay, Google Wallet, banking apps, and enterprise enrollment will stop working. Bypasses (Play Integrity Fix module) exist but break frequently." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══ Samsung Odin Section (bound to Odin sub-VM) ═══ -->
            <StackPanel DataContext="{Binding Odin}">

                <!-- Knox banner -->
                <Border Style="{StaticResource Card}"
                        Background="#22F38BA8"
                        BorderBrush="{DynamicResource AppDestructive}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsKnoxIntact, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="KNOX IS INTACT" FontWeight="Bold" Foreground="{DynamicResource AppDestructive}" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}">
                            Flashing a custom AP / kernel / boot image WILL trip the Knox eFuse permanently and disable Samsung Pay, Secure Folder, Health, and corporate enrollment. Once tripped, only board replacement reverses it. Flash stock-only via Odin to keep Knox alive.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}"
                        Background="#22F9E2AF"
                        BorderBrush="{DynamicResource AppWarning}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsKnoxTripped, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Knox eFuse is already tripped (warranty bit != 0). Further flashes won't restore Knox features." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- One UI 8 bootloader lock warning -->
                <Border Style="{StaticResource Card}"
                        Background="#22F38BA8"
                        BorderBrush="{DynamicResource AppDestructive}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsOneUi8BootloaderLocked, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="ONE UI 8 — BOOTLOADER UNLOCK REMOVED" FontWeight="Bold" Foreground="{DynamicResource AppDestructive}" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}">
                            Samsung removed the OEM unlock toggle in One UI 8 firmware. Custom flashing is not possible on this device without first downgrading to One UI 7.1 (Jan 2025 patch), unlocking the bootloader there, then re-flashing One UI 8 while preserving the BL partition. Attempting to flash without an unlocked bootloader will fail or hard-brick the device.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Odin Diagnostic -->
                <Border Style="{StaticResource Card}"
                        Background="#22F9E2AF"
                        BorderBrush="{DynamicResource AppWarning}"
                        Margin="0,0,0,12"
                        Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Samsung Odin" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource AppForeground}" Margin="0,4,0,8" />

                <!-- EFS-Clear gate -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding EfsClearEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="EFS clear toggle">
                            <CheckBox.Content>
                                <TextBlock>
                                    <Run Text="EFS-Clear" FontWeight="Bold" /><Run Text=" — wipe /efs (IMEI / NVRAM). DO NOT enable unless you have an EFS backup AND know exactly why." />
                                </TextBlock>
                            </CheckBox.Content>
                        </CheckBox>
                        <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="24,4,0,0" TextWrapping="Wrap">
                            OFF by default (correct). Toggling this is one of the fastest ways to brick a Samsung permanently.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Archive path + buttons -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Browse" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseArchiveCommand}" Margin="0,0,6,0" AutomationProperties.Name="Browse for Odin archive file" />
                                <Button Content="Inspect" Style="{StaticResource SecondaryButton}" Command="{Binding InspectCommand}" Margin="0,0,6,0" AutomationProperties.Name="Inspect Odin archive contents" />
                                <Button Content="Dry-run plan" Style="{StaticResource PrimaryButton}" Command="{Binding DryRunCommand}" AutomationProperties.Name="Preview Odin flash plan without writing" />
                            </StackPanel>
                            <TextBlock Text="ARCHIVE" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding ArchivePath, FallbackValue='(none)', TargetNullValue='(none)'}"
                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12"
                                   Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding Info, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                            <Run Text="Package hint:" /><Run Text="{Binding Info.PackageHint, FallbackValue='?', Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Odin entries -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding Entries.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Entry.Name}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="13" Foreground="{DynamicResource AppForeground}" />
                                        <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="11">
                                            <Run Text="-> " /><Run Text="{Binding Entry.PartitionGuess, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Entry.SizeDisplay}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="11" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Thor execute gate -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding Entries.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="FLASH VIA THOR" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                            Thor Flash Utility writes the selected entries to the device. This CANNOT be undone. Run a dry-run first.
                        </TextBlock>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Execute Flash" Style="{StaticResource PrimaryButton}" Command="{Binding ThorFlashCommand}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Execute Thor flash to device" />
                            <CheckBox IsChecked="{Binding ThorConfirmed, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Confirm destructive flash operation">
                                <CheckBox.Content>
                                    <TextBlock Text="I understand this writes to the device and cannot be undone" FontWeight="SemiBold" />
                                </CheckBox.Content>
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding IsThorAvailable, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}">
                            Thor Flash Utility not found on PATH or in the tools cache. Install Thor or set the path in Settings.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Odin status / dry-run output -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding StatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="ODIN STATUS" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Odin flash progress -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding FlashStatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelFlashCommand}"
                                    Visibility="{Binding IsFlashing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" AutomationProperties.Name="Cancel Thor flash" />
                            <TextBlock Text="THOR STATUS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding FlashStatusText}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <ProgressBar Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding FlashProgressFraction, Converter={x:Static vm:FractionToPercentConverter.Instance}}"
                                     Foreground="{DynamicResource AppAccent}" Background="{DynamicResource AppCardBackground}"
                                     Visibility="{Binding IsFlashing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- Odin flash warnings -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding FlashWarnings.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="WARNINGS" Style="{StaticResource FieldLabel}" />
                        <ItemsControl ItemsSource="{Binding FlashWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AppWarning}" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ═══ Fastboot Flash Section (bound to Fastboot sub-VM) ═══ -->
            <StackPanel DataContext="{Binding Fastboot}">

                <Border Height="1" Background="{DynamicResource AppCardBorder}" Margin="0,8,0,16" />
                <TextBlock Text="Fastboot Flash" FontWeight="SemiBold" FontSize="16"
                           Foreground="{DynamicResource AppForeground}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SubheadingTextBlock}" Margin="0,0,0,12"
                           Text="Flash individual .img files via fastboot for non-Samsung devices (Pixel, OnePlus, Xiaomi, etc.)." />

                <!-- Fastboot diagnostic -->
                <Border Style="{StaticResource Card}"
                        Background="#22F9E2AF"
                        BorderBrush="{DynamicResource AppWarning}"
                        Margin="0,0,0,12"
                        Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Fastboot image list + buttons -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add images" Style="{StaticResource SecondaryButton}" Command="{Binding AddFastbootImagesCommand}" Margin="0,0,6,0" AutomationProperties.Name="Add fastboot image files" />
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFastbootImagesCommand}" Margin="0,0,6,0" AutomationProperties.Name="Clear fastboot image list" />
                                <Button Content="Dry-run" Style="{StaticResource SecondaryButton}" Command="{Binding FastbootDryRunCommand}" Margin="0,0,6,0" AutomationProperties.Name="Preview fastboot flash plan" />
                                <Button Content="Flash" Style="{StaticResource PrimaryButton}" Command="{Binding FastbootFlashCommand}" AutomationProperties.Name="Flash images via fastboot" />
                            </StackPanel>
                            <TextBlock Text="IMAGES" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding FastbootImages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Partition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding FileName}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="11" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                        <Button Grid.Column="4" Content="X" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="4,2"
                                                Command="{Binding DataContext.RemoveFastbootImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Fastboot options -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding ActiveSlotValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" IsEnabled="{Binding SetActiveSlot}" VerticalAlignment="Center" AutomationProperties.Name="Active slot value" />
                            <CheckBox IsChecked="{Binding SetActiveSlot, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Set active slot after flash toggle">
                                <CheckBox.Content><TextBlock Text="Set active slot after flash (A/B devices)" /></CheckBox.Content>
                            </CheckBox>
                        </DockPanel>
                        <CheckBox IsChecked="{Binding RebootAfterFlash, Mode=TwoWay}" AutomationProperties.Name="Reboot device after flash toggle">
                            <CheckBox.Content><TextBlock Text="Reboot after flash (only if all partitions succeed)" /></CheckBox.Content>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding DisableAvb, Mode=TwoWay}" Margin="0,6,0,0" AutomationProperties.Name="Disable AVB verification toggle">
                            <CheckBox.Content>
                                <TextBlock TextWrapping="Wrap" Text="Disable AVB verification (flash vbmeta with --disable-verity --disable-verification). Required when flashing custom boot/recovery images on devices with locked or relocked bootloaders." />
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Flash progress -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding FlashStatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelFlashCommand}"
                                    Visibility="{Binding IsFlashing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" AutomationProperties.Name="Cancel fastboot flash" />
                            <TextBlock Text="FLASH STATUS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding FlashStatusText}" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" FontSize="12" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <ProgressBar Height="4" Minimum="0" Maximum="100"
                                     Value="{Binding FlashProgressFraction, Converter={x:Static vm:FractionToPercentConverter.Instance}}"
                                     Foreground="{DynamicResource AppAccent}" Background="{DynamicResource AppCardBackground}"
                                     Visibility="{Binding IsFlashing, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- Flash warnings -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                        Visibility="{Binding FlashWarnings.Count, Converter={x:Static vm:CountToVisibleIfPositiveConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Text="WARNINGS" Style="{StaticResource FieldLabel}" />
                        <ItemsControl ItemsSource="{Binding FlashWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AppWarning}" FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
