<UserControl x:Class="Devicer.App.Views.BackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Devicer.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleForeground}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,28,32,32" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Heading -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Load partitions"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadPartitionsCommand}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Load device partition list" />
                <Button Content="Back up selected"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartBackupCommand}"
                        AutomationProperties.Name="Back up selected partitions" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Backup" Style="{StaticResource HeadingTextBlock}" />
                <TextBlock Style="{StaticResource SubheadingTextBlock}">
                    <Run Text="Direct " /><Run Text="dd" FontFamily="Consolas, JetBrains Mono, Cascadia Mono" /><Run Text=" of selected partitions via root, pulled to host with SHA256 verification. Critical (EFS / modem / persist) pre-selected on Samsung." />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- EFS warning -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Background="#22F38BA8"
                BorderBrush="{DynamicResource AppDestructive}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="EFS / NVRAM IS ONE-WAY" FontWeight="Bold" Foreground="{DynamicResource AppDestructive}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}">
                    Losing EFS bricks the device's IMEI permanently — there is no recovery short of a board swap.
                    Always create a fresh backup before flashing AP/CP/CSC, before relocking the bootloader, and before any "EFS-Clear" Odin operation.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Diagnostic -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Background="#22F9E2AF"
                BorderBrush="{DynamicResource AppWarning}"
                Margin="0,0,0,12"
                Visibility="{Binding Diagnostic, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AppWarning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Diagnostic}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Status / progress -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding StatusText, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelBackupCommand}"
                            Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"
                            AutomationProperties.Name="Cancel partition backup" />
                    <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="0" />
                </DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AppForeground}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay, Converter={x:Static vm:FractionToPercentConverter.Instance}}"
                             Minimum="0" Maximum="100"
                             Height="8"
                             Background="{DynamicResource AppSurface}"
                             Foreground="{DynamicResource AppAccent}"
                             BorderBrush="{DynamicResource AppBorder}"
                             Visibility="{Binding IsRunning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Border>

        <!-- Partitions -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Partitions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                Style="{StaticResource BadgeDanger}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding Info.IsCritical, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                                            <TextBlock Text="CRITICAL" Foreground="{DynamicResource AppDestructive}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding Info.Name}"
                                                   FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource AppForeground}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Info.CriticalReason}"
                                               Foreground="{DynamicResource AppMutedForeground}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Info.CriticalReason, Converter={x:Static vm:NullToCollapsedConverter.Instance}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Info.SizeDisplay}"
                                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppMutedForeground}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Warnings + open-folder -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding LastBackupFolder, Converter={x:Static vm:NullToCollapsedConverter.Instance}}">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Content="Open folder"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenLastFolderCommand}"
                            AutomationProperties.Name="Open last backup folder" />
                    <TextBlock Text="LAST BACKUP" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding LastBackupFolder}"
                           FontFamily="Consolas, JetBrains Mono, Cascadia Mono"
                           FontSize="12"
                           Foreground="{DynamicResource AppForeground}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource AppWarning}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
